        {
          "name": "01 - Copa 2026",
          "item": [
            {
              "name": "Competicao FIFA World Cup",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "X-Auth-Token",
                    "value": "{{footballDataToken}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{footballDataBaseUrl}}/competitions/{{competitionCode}}",
                  "host": [
                    "{{footballDataBaseUrl}}"
                  ],
                  "path": [
                    "competitions",
                    "{{competitionCode}}"
                  ]
                },
                "description": "World Cup na football-data.org usa codigo WC e id 2000."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const json = pm.response.json();",
                      "pm.test('Competicao WC', function () {",
                      "  pm.expect(json.code).to.eql('WC');",
                      "});",
                      "if (json.id) {",
                      "  pm.collectionVariables.set('competitionId', String(json.id));",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Todos os jogos da Copa 2026",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "X-Auth-Token",
                    "value": "{{footballDataToken}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{footballDataBaseUrl}}/competitions/{{competitionCode}}/matches?season={{season}}",
                  "host": [
                    "{{footballDataBaseUrl}}"
                  ],
                  "path": [
                    "competitions",
                    "{{competitionCode}}",
                    "matches"
                  ],
                  "query": [
                    {
                      "key": "season",
                      "value": "{{season}}"
                    }
                  ]
                },
                "description": "Endpoint principal para mapear matches.id da API com matches.match_number do banco."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const json = pm.response.json();",
                      "const matches = json.matches || [];",
                      "pm.test('Retornou jogos', function () {",
                      "  pm.expect(matches.length).to.be.greaterThan(0);",
                      "});",
                      "const first = matches[0];",
                      "if (first && first.id) {",
                      "  pm.collectionVariables.set('matchId', String(first.id));",
                      "  if (first.utcDate) {",
                      "    pm.collectionVariables.set('matchDate', first.utcDate.slice(0, 10));",
                      "  }",
                      "}",
                      "const ids = matches.slice(0, 20).map(function (match) { return match.id; }).filter(Boolean).join(',');",
                      "if (ids) {",
                      "  pm.collectionVariables.set('matchIds', ids);",
                      "}"
                    ]
                  }
                }
              ]
            },
