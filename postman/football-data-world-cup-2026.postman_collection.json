      "info": {
        "_postman_id": "e6428f87-9d2a-4827-b334-38d8d4c54af4",
        "name": "WorldBet 26 - football-data.org Copa 2026",
        "description": "Collection para testar os endpoints v4 da football-data.org usados no WorldBet 26. Preencha footballDataToken antes de executar.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "auth": {
        "type": "noauth"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Resposta HTTP esperada', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});",
              "",
              "const requestsAvailable = pm.response.headers.get('X-RequestsAvailable');",
              "const resetIn = pm.response.headers.get('X-RequestCounter-Reset');",
              "if (requestsAvailable) {",
              "  console.log('Requests disponiveis:', requestsAvailable, 'reset em:', resetIn || 'n/a');",
              "}",
              "",
              "if (pm.response.code !== 204 && pm.response.text()) {",
              "  pm.test('Resposta JSON', function () {",
              "    pm.expect(function () { pm.response.json(); }).not.to.throw();",
              "  });",
              "}"
            ]
          }
        }
      ],
